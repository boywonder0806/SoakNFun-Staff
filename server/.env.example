PORT=3001
JWT_SECRET=change_this_to_a_long_random_secret_in_production
DATABASE_URL=postgresql://user:password@localhost:5432/blue_bayou_staff

# Netchex HRM Integration (fill in when ready)
NETCHEX_API_KEY=your_netchex_api_key
NETCHEX_BASE_URL=https://api.netchex.com/v1

CLIENT_URL=http://localhost:5173

# Smartwaiver mirror (`smartwaiver` schema in the app database)
# API key from the Smartwaiver console. Leave unset to disable the sync.
SMARTWAIVER_API_KEY=
# Optional: keep the mirror in a separate database instead.
# SMARTWAIVER_DATABASE_URL=
# Optional: earliest waiver to copy (UTC). Defaults to 2025-11-15T00:00:00Z.
# SMARTWAIVER_BACKFILL_START=2025-11-15T00:00:00Z
